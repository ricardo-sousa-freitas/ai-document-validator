# Example environment file - copy to .env and configure as needed
# No secrets are stored here; all configuration is safe to commit

# Optional: Azure OpenAI configuration for LLM fallback extraction
# Leave these commented when heuristic extraction is sufficient.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_api_key_here
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name

