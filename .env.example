# Example environment file - copy to .env and configure as needed
# No secrets are stored here; all configuration is safe to commit

# Optional: API Keys for LLM providers (if/when integrated)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Document extraction mode: "fixture" | "text" | "pdf"
EXTRACTION_MODE=fixture

# Default rule configuration
DEFAULT_MAX_AGE_DAYS=90
DEFAULT_ALLOWED_CURRENCIES=EUR,GBP,USD
